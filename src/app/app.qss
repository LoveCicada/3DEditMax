/* Mockup palette — docs/ui/design/mockup.html :root */

QWidget {
  background-color: #0e1320;
  color: #eef1f9;
  font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 13px;
}

QMainWindow {
  background-color: #0e1320;
}

QMenuBar {
  background-color: #10141f;
  border-bottom: 1px solid #181d2c;
  padding: 2px 0;
}

QMenuBar::item {
  background: transparent;
  padding: 4px 10px;
  border-radius: 6px;
}

QMenuBar::item:selected {
  background-color: rgba(91, 141, 239, 0.16);
  color: #7aa1ff;
}

QMenu {
  background-color: #161b2b;
  border: 1px solid #272e44;
  padding: 4px 0;
}

QMenu::item {
  padding: 5px 24px 5px 12px;
}

QMenu::item:selected {
  background-color: rgba(91, 141, 239, 0.16);
  color: #eef1f9;
}

QToolBar {
  background-color: #131826;
  border-bottom: 1px solid #1a2032;
  spacing: 6px;
  padding: 4px 8px;
}

QToolBar QToolButton {
  background-color: #0d1119;
  color: #b3bbd1;
  border: 1px solid #1d2335;
  border-radius: 6px;
  padding: 4px 10px;
  min-height: 22px;
}

QToolBar QToolButton:hover {
  background-color: #1a2032;
  color: #eef1f9;
  border-color: #323a55;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
  background-color: #1b2541;
  color: #ffffff;
  border-color: #3a4a76;
}

QDockWidget {
  titlebar-close-icon: url(none);
  titlebar-normal-icon: url(none);
  color: #eef1f9;
}

QDockWidget::title {
  background-color: #161b2b;
  border: 1px solid #272e44;
  border-radius: 6px;
  padding: 4px 6px;
  text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
  background: #0d1119;
  border: 1px solid #272e44;
  border-radius: 4px;
  padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
  background: #5b8def;
}

QFrame#tutorialStrip {
  background-color: #161b2b;
  border-top: 1px solid #1a2032;
}

QGroupBox {
  background-color: #1d2335;
  border: 1px solid #272e44;
  border-radius: 10px;
  margin-top: 8px;
  padding: 6px;
  font-weight: 600;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 0 6px;
  color: #eef1f9;
}

/* World / View / Projection domain accents */
QGroupBox#sectionWorld {
  border-left: 4px solid #ef476f;
}

QGroupBox#sectionWorld::title {
  color: #ef476f;
}

QGroupBox#sectionView {
  border-left: 4px solid #06d6a0;
}

QGroupBox#sectionView::title {
  color: #06d6a0;
}

QGroupBox#sectionProjection {
  border-left: 4px solid #ffb703;
}

QGroupBox#sectionProjection::title {
  color: #ffb703;
}

/* Matrix keys */
QGroupBox#sectionMatrixW {
  border-left: 4px solid #4cc9f0;
}

QGroupBox#sectionMatrixW::title {
  color: #4cc9f0;
}

QGroupBox#sectionMatrixV {
  border-left: 4px solid #b388ff;
}

QGroupBox#sectionMatrixV::title {
  color: #b388ff;
}

QGroupBox#sectionMatrixP {
  border-left: 4px solid #ffb703;
}

QGroupBox#sectionMatrixP::title {
  color: #ffb703;
}

QGroupBox#sectionMVP {
  border-left: 4px solid #f72585;
}

QGroupBox#sectionMVP::title {
  color: #f72585;
}

/* Per-matrix demoHot glow (mockup keys) */
QGroupBox#sectionMatrixW[demoHot="true"] {
  background-color: rgba(76, 201, 240, 0.14);
  border: 1px solid #4cc9f0;
  border-left: 4px solid #4cc9f0;
}

QGroupBox#sectionMatrixV[demoHot="true"] {
  background-color: rgba(179, 136, 255, 0.14);
  border: 1px solid #b388ff;
  border-left: 4px solid #b388ff;
}

QGroupBox#sectionMatrixP[demoHot="true"] {
  background-color: rgba(255, 183, 3, 0.14);
  border: 1px solid #ffb703;
  border-left: 4px solid #ffb703;
}

QGroupBox#sectionMVP[demoHot="true"] {
  background-color: rgba(247, 37, 133, 0.14);
  border: 1px solid #f72585;
  border-left: 4px solid #f72585;
}

QLabel {
  background: transparent;
  color: #eef1f9;
}

QFormLayout QLabel,
QHBoxLayout QLabel {
  color: #7c8499;
}

QLabel#axisLabelX {
  color: #ef476f;
  font-weight: 600;
}

QLabel#axisLabelY {
  color: #06d6a0;
  font-weight: 600;
}

QLabel#axisLabelZ {
  color: #4cc9f0;
  font-weight: 600;
}

QGroupBox#sectionTracker {
  border-left: 4px solid #f72585;
}

QGroupBox#sectionTracker::title {
  color: #f72585;
}

QGroupBox#sectionObject {
  border-left: 4px solid #5b8def;
}

QGroupBox#sectionObject::title {
  color: #9fbcff;
}

QPushButton#btnPreset {
  padding: 3px 8px;
  min-height: 20px;
  font-size: 12px;
}

QPushButton {
  background-color: #0d1119;
  color: #b3bbd1;
  border: 1px solid #272e44;
  border-radius: 6px;
  padding: 4px 12px;
  min-height: 22px;
}

QPushButton:hover {
  background-color: #1a2032;
  color: #eef1f9;
  border-color: #5b8def;
}

QPushButton:pressed {
  background-color: #1b2541;
  color: #ffffff;
  border-color: #5b8def;
}

QPushButton:disabled {
  background-color: #161b2b;
  color: #5a6175;
  border-color: #272e44;
}

QPushButton#btnDemo {
  background-color: #0d1119;
  color: #5b8def;
  border: 1px solid #5b8def;
}

QPushButton#btnDemo:hover {
  background-color: #5b8def;
  color: #0e1320;
  border-color: #5b8def;
}

QPushButton#btnDemo:pressed {
  background-color: #7aa1ff;
  color: #0e1320;
  border-color: #7aa1ff;
}

QDoubleSpinBox,
QSpinBox,
QComboBox,
QLineEdit {
  background-color: #0c1019;
  color: #eef1f9;
  border: 1px solid #272e44;
  border-radius: 6px;
  padding: 3px 6px;
  min-height: 22px;
  selection-background-color: #5b8def;
  selection-color: #0e1320;
}

QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus,
QLineEdit:focus {
  border-color: #5b8def;
}

QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QSpinBox::up-button,
QSpinBox::down-button {
  background-color: #1d2335;
  border: none;
  border-radius: 3px;
  width: 16px;
}

QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
  background-color: #5b8def;
}

QComboBox::drop-down {
  border: none;
  border-left: 1px solid #272e44;
  border-top-right-radius: 6px;
  border-bottom-right-radius: 6px;
  width: 20px;
  background: #1d2335;
}

QComboBox::down-arrow {
  image: none;
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-top: 5px solid #7c8499;
  margin-right: 6px;
}

QComboBox QAbstractItemView {
  background-color: #161b2b;
  color: #eef1f9;
  border: 1px solid #272e44;
  selection-background-color: rgba(91, 141, 239, 0.16);
  selection-color: #eef1f9;
  outline: none;
}

QPlainTextEdit,
QTextEdit {
  background-color: #0c1019;
  color: #eef1f9;
  border: 1px solid #272e44;
  border-radius: 6px;
  padding: 6px;
  font-family: "Consolas", "Courier New", monospace;
  font-size: 12px;
}

QPlainTextEdit:focus,
QTextEdit:focus {
  border-color: #5b8def;
}

QScrollBar:vertical {
  background: transparent;
  width: 8px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: #272e44;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::handle:vertical:hover {
  background: #3d4666;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
  height: 0;
}

QScrollBar:horizontal {
  background: transparent;
  height: 8px;
  margin: 0;
}

QScrollBar::handle:horizontal {
  background: #272e44;
  border-radius: 4px;
  min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
  background: #3d4666;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: none;
  width: 0;
}

QStatusBar {
  background-color: #10141f;
  color: #7c8499;
  border-top: 1px solid #1a2032;
}

QSplitter::handle {
  background-color: #272e44;
}

QSplitter::handle:hover {
  background-color: #5b8def;
}

QCheckBox {
  spacing: 6px;
  color: #eef1f9;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #272e44;
  border-radius: 4px;
  background: #0c1019;
}

QCheckBox::indicator:checked {
  background: #5b8def;
  border-color: #5b8def;
}

QTabWidget::pane {
  border: 1px solid #272e44;
  border-radius: 6px;
  background: #161b2b;
}

QTabBar::tab {
  background: #1d2335;
  color: #7c8499;
  border: 1px solid #272e44;
  border-bottom: none;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  padding: 5px 12px;
}

QTabBar::tab:selected {
  background: #161b2b;
  color: #5b8def;
  border-color: #5b8def;
}

QMessageBox {
  background-color: #161b2b;
}

QFileDialog {
  background-color: #161b2b;
}
