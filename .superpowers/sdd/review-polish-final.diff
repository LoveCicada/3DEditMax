+    const UINT count = kCandidates[i];
+    UINT levels = 0;
+    m_device->CheckMultisampleQualityLevels(
+        DXGI_FORMAT_R8G8B8A8_UNORM, count, &levels);
+    if (levels > 0) {
+      m_sampleCount = count;
+      m_sampleQuality = 0;
+      return;
+    }
+  }
+}
