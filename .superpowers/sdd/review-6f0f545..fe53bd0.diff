+
+class DebugDraw {
+public:
+  void create(ID3D11Device* device);
+  void create(ID3D11Device* device, const std::wstring& shaderDir);
+  void reset();
+  void draw(ID3D11DeviceContext* context,
+            const StateSnapshot& snap,
+            DirectX::FXMMATRIX view,
+            DirectX::FXMMATRIX proj);
