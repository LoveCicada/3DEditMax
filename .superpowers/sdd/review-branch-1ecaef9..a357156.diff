+void MainWindow::onTutorialApply(const TeachingState& t) {
+  if (t.demoPlaying) {
+    m_teaching.demoPlaying = true;
+    m_demo.start(m_teaching);
+    m_demo.tick(0.f, &m_teaching);
+    syncTeaching();
+    m_demoTimer->start();
+    return;
+  }
+  m_demoTimer->stop();
+  m_teaching = t;
+  m_teaching.demoPlaying = false;
+  syncTeaching();
+}
